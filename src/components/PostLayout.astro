---
interface Props {
  title: string;
  date: Date;
  tags?: string[];
  backLink: string;
  backLabel: string;
}

const { title, date, tags, backLink, backLabel } = Astro.props;
const base = import.meta.env.BASE_URL;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<div class="post-content">
  <a class="back-link" href={`${base}${backLink}`}>&larr; {backLabel}</a>
  <div class="post-header">
    <h1>{title}</h1>
    <div class="post-meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {tags && tags.length > 0 && (
        <span>
          {' · '}
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </span>
      )}
    </div>
  </div>
  <div class="post-body">
    <slot />
  </div>
</div>
