---
interface Props {
  title: string;
  description: string;
  status: 'active' | 'shipped' | 'paused' | 'archived';
  tech: string[];
  slug: string;
  github?: string;
  appStore?: string;
  liveUrl?: string;
  image?: string;
}

const { title, description, status, tech, slug, github, appStore, liveUrl, image } = Astro.props;
const base = import.meta.env.BASE_URL;
// Cards show the first few tags; the project page lists them all.
const shownTech = tech.slice(0, 4);
---

<div class="project-card">
  {image && (
    <div class="project-card-image">
      <img src={image} alt={title} loading="lazy" />
    </div>
  )}
  <div class="project-card-content">
    <div class="project-card-header">
      <a class="project-card-title" href={`${base}projects/${slug}/`}>{title}</a>
      <span class={`project-card-status status-${status}`}>{status}</span>
    </div>
    <p class="project-card-desc">{description}</p>
    <div class="project-card-tags">
      {shownTech.map((t) => <span class="tag">{t}</span>)}
    </div>
    <div class="project-card-links">
      {github && <a href={github} target="_blank" rel="noopener">GitHub</a>}
      {appStore && <a href={appStore} target="_blank" rel="noopener">App Store</a>}
      {liveUrl && <a href={liveUrl} target="_blank" rel="noopener">Website</a>}
      <a href={`${base}projects/${slug}/`}>View project &rarr;</a>
    </div>
  </div>
</div>
