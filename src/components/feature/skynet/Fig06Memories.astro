---
/**
 * Fig06Memories (fig-06): Four memories. The post's centrepiece loop:
 * working -> episodic -> semantic -> procedural -> working.
 * Props: `caption` (text from the MDX), `wide` (default true).
 * Default slot: the text alternative (`<ol>`) written in the MDX.
 *
 * Drawing: two inline SVGs. `.fig-narrow` (under 760px) is a vertical
 * loop with a return arrow; `.fig-broad` (760px and up) is a square loop
 * that also shows the two extra reads into working memory.
 * Labels: 03-architecture.md Diagram D (lines 61-76).
 * Motion: one dot runs round the loop once when the figure scrolls into
 * view (onceInView); "Play the loop" runs it again. A tap, click or
 * Enter on a memory shows what it holds and an example. Reduced motion:
 * no dots, the Play button stays hidden, the panels still work.
 * No JS: the SVG is static and complete; the controls stay hidden.
 * Memory styles (mem-*) are the same mapping as Fig12Dirs (Fig06Memory.ts).
 */
import Figure from '../Figure.astro';
import { MEMORIES, MEM_BY_KEY, type MemKey } from './Fig06Memory';

interface Props {
  caption?: string;
  wide?: boolean;
}

const { caption = 'TODO', wide = true } = Astro.props;

interface Node { key: MemKey; x: number; y: number; w: number; h: number }
interface Edge { d: string; step: number; minor?: boolean }
interface Label { x: number; y: number; lines: string[]; anchor?: string; rotate?: boolean; bg?: boolean }

// Narrow (phone first): viewBox 320 x 456, a vertical loop.
const narrow = {
  vb: '0 0 320 456',
  nodes: [
    { key: 'working', x: 56, y: 8, w: 248, h: 60 },
    { key: 'episodic', x: 56, y: 132, w: 248, h: 60 },
    { key: 'semantic', x: 56, y: 256, w: 248, h: 60 },
    { key: 'procedural', x: 56, y: 380, w: 248, h: 60 },
  ] as Node[],
  edges: [
    { d: 'M92 68 V126', step: 0 },
    { d: 'M92 192 V250', step: 1 },
    { d: 'M92 316 V374', step: 2 },
    { d: 'M56 410 H24 V38 H50', step: 3 },
  ] as Edge[],
  labels: [
    { x: 104, y: 104, lines: ['reports, handoffs, ledgers'] },
    { x: 104, y: 228, lines: ['dream: consolidate + cite'] },
    { x: 104, y: 352, lines: ['proposals, owner approves'] },
    { x: 44, y: 224, lines: ['loaded at start'], anchor: 'middle', rotate: true },
  ] as Label[],
};

// Broad (760px and up): viewBox 720 x 404, a square loop plus two reads.
const broad = {
  vb: '0 0 720 404',
  nodes: [
    { key: 'working', x: 40, y: 36, w: 200, h: 64 },
    { key: 'episodic', x: 480, y: 36, w: 200, h: 64 },
    { key: 'semantic', x: 480, y: 300, w: 200, h: 64 },
    { key: 'procedural', x: 40, y: 300, w: 200, h: 64 },
  ] as Node[],
  edges: [
    { d: 'M240 58 H474', step: 0 },
    { d: 'M580 100 V294', step: 1 },
    { d: 'M480 322 H246', step: 2 },
    { d: 'M140 300 V106', step: 3 },
    { d: 'M480 82 H246', step: 4, minor: true },
    { d: 'M496 300 L232 110', step: 4, minor: true },
  ] as Edge[],
  labels: [
    { x: 360, y: 46, lines: ['reports, handoffs, ledgers'], anchor: 'middle' },
    { x: 568, y: 192, lines: ['dream:', 'consolidate + cite'], anchor: 'end' },
    { x: 360, y: 344, lines: ['proposals, owner approves'], anchor: 'middle' },
    { x: 152, y: 206, lines: ['loaded at start'] },
    { x: 360, y: 104, lines: ['latest handoff + its citations'], anchor: 'middle' },
    { x: 362, y: 198, lines: ['index at start,', 'topics on demand'], anchor: 'middle', bg: true },
  ] as Label[],
};

const variants = [
  { id: 'n', cls: 'fig-narrow', ...narrow },
  { id: 'b', cls: 'fig-broad', ...broad },
];
---

<Figure id="fig-06" caption={caption} wide={wide} interactive>
  <div slot="svg" class="f6">
    {variants.map((v) => (
      <svg class={v.cls} viewBox={v.vb} xmlns="http://www.w3.org/2000/svg" data-f6-svg>
        <defs>
          <marker id={`f6${v.id}-arr`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 z" class="arr-head" />
          </marker>
        </defs>
        {v.edges.map((e) => (
          <path d={e.d} class:list={['edge', { minor: e.minor }]} data-step={e.step} marker-end={`url(#f6${v.id}-arr)`} />
        ))}
        {v.labels.map((l) => (
          <g class="lbl" transform={l.rotate ? `translate(${l.x} ${l.y}) rotate(-90)` : undefined}>
            {l.bg && <rect class="lbl-bg" x={l.x - 62} y={l.y - 15} width="124" height={l.lines.length * 18 + 6} rx="4" />}
            <text x={l.rotate ? 0 : l.x} y={l.rotate ? 0 : l.y} text-anchor={l.anchor ?? 'start'}>
              {l.lines.map((t, i) => (
                <tspan x={l.rotate ? 0 : l.x} dy={i === 0 ? 0 : 18}>{t}</tspan>
              ))}
            </text>
          </g>
        ))}
        {v.nodes.map((n) => (
          <g class="mem-node" data-mem={n.key}>
            <rect class="sel-ring" x={n.x - 5} y={n.y - 5} width={n.w + 10} height={n.h + 10} rx="11" />
            <rect class={`mem mem-${n.key}`} x={n.x} y={n.y} width={n.w} height={n.h} rx="8" />
            <text class="mem-title" x={n.x + n.w / 2} y={n.y + n.h / 2 - 4} text-anchor="middle">{MEM_BY_KEY[n.key].name}</text>
            <text class="mem-sub" x={n.x + n.w / 2} y={n.y + n.h / 2 + 16} text-anchor="middle">{MEM_BY_KEY[n.key].short}</text>
          </g>
        ))}
      </svg>
    ))}
  </div>
  <div slot="controls" class="f6-controls">
    <div class="mem-panel">
      <p class="mem-hint" data-f6-hint>Tap a memory to see what it holds.</p>
      {MEMORIES.map((m) => (
        <div class="mem-info" data-mem-info={m.key} hidden>
          <p class="mem-name"><span class={`mem-chip mem-${m.key}`} aria-hidden="true"></span>{m.name}</p>
          <dl>
            <dt>Holds</dt><dd>{m.holds}</dd>
            <dt>Example</dt><dd>{m.example}</dd>
            <dt>Rule</dt><dd>{m.rule}</dd>
          </dl>
        </div>
      ))}
    </div>
    <button type="button" class="fig-btn" data-f6-play hidden>Play the loop</button>
  </div>
  <slot>
    <ol><li>TODO</li></ol>
  </slot>
</Figure>

<style>
  .f6 svg {
    max-width: 440px;
    margin: 0 auto;
  }
  .f6 svg.fig-broad {
    max-width: 840px;
  }
  /* Narrow drawing under 760px, broad from 760px (the broad one needs that
     width for 12px labels). Selectors outrank feature.css's
     `.fig-svg svg { display: block }`, which otherwise shows both.
     The 760px switch point stays after that. */
  /* T-011 removes this once the shared fix lands */
  :global(.post-content.feature) .f6 svg.fig-broad {
    display: none;
  }
  @media (min-width: 760px) {
    :global(.post-content.feature) .f6 svg.fig-narrow {
      display: none;
    }
    :global(.post-content.feature) .f6 svg.fig-broad {
      display: block;
    }
  }

  .edge {
    fill: none;
    stroke: var(--text);
    stroke-opacity: 0.55;
    stroke-width: 1.5;
  }
  .edge.minor {
    stroke-dasharray: 4 4;
  }
  .arr-head {
    fill: var(--text);
    fill-opacity: 0.55;
  }
  .lbl text {
    font-size: 13px;
    fill-opacity: 0.85;
  }
  .lbl-bg {
    fill: var(--bg);
  }
  .mem-title {
    font-size: 15px;
    font-weight: 600;
  }
  .mem-sub {
    font-size: 13px;
  }
  .sel-ring {
    fill: none;
    stroke: var(--text);
    stroke-width: 2;
    opacity: 0;
  }
  .mem-node[aria-pressed='true'] .sel-ring,
  .mem-node:focus-visible .sel-ring {
    opacity: 1;
  }
  .mem-node[role='button'] {
    cursor: pointer;
    outline: none;
  }
  @media (hover: hover) {
    .mem-node[role='button']:hover .sel-ring {
      opacity: 0.4;
    }
  }

  /* Memory styles: the same mapping as Fig12Dirs. Colour is never the only
     cue: dash pattern, stroke weight and fill differ too. */
  .mem {
    stroke-width: 1.5;
  }
  .mem-working {
    fill: var(--bg);
    stroke: var(--text);
    stroke-dasharray: 6 4;
  }
  .mem-episodic {
    fill: var(--code-bg);
    stroke: var(--muted);
  }
  .mem-semantic {
    fill: color-mix(in srgb, var(--accent) 14%, var(--bg));
    stroke: var(--accent);
  }
  .mem-procedural {
    fill: color-mix(in srgb, var(--accent) 30%, var(--bg));
    stroke: var(--accent);
    stroke-width: 3;
  }

  :global(.flow-dot) {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 1.5;
  }

  .f6-controls {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    width: 100%;
  }
  .mem-panel {
    width: 100%;
    font-size: 14px;
    line-height: 1.6;
  }
  .mem-hint {
    margin: 0;
    color: var(--text);
    opacity: 0.8;
  }
  .mem-info[hidden] {
    display: none;
  }
  .mem-name {
    margin: 0 0 4px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mem-chip {
    display: inline-block;
    width: 24px;
    height: 16px;
    border-radius: 4px;
    border: 1.5px solid;
    box-sizing: border-box;
  }
  .mem-chip.mem-working {
    background: var(--bg);
    border-color: var(--text);
    border-style: dashed;
  }
  .mem-chip.mem-episodic {
    background: var(--code-bg);
    border-color: var(--muted);
  }
  .mem-chip.mem-semantic {
    background: color-mix(in srgb, var(--accent) 14%, var(--bg));
    border-color: var(--accent);
  }
  .mem-chip.mem-procedural {
    background: color-mix(in srgb, var(--accent) 30%, var(--bg));
    border-color: var(--accent);
    border-width: 3px;
  }
  .mem-info dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 2px 12px;
  }
  .mem-info dt {
    font-weight: 500;
  }
  .mem-info dd {
    margin: 0;
  }
</style>

<script>
  import { getFigure, showControls, announce } from '../figure';
  import { prefersReducedMotion, onceInView } from '../motion';
  import { flow, visible } from './Fig06Flow';

  const fig = getFigure('fig-06');
  if (fig) {
    const svgs = Array.from(fig.root.querySelectorAll<SVGSVGElement>('[data-f6-svg]'));
    const nodes = Array.from(fig.root.querySelectorAll<SVGGElement>('.mem-node'));
    const infos = Array.from(fig.root.querySelectorAll<HTMLElement>('[data-mem-info]'));
    const hint = fig.root.querySelector<HTMLElement>('[data-f6-hint]');
    const play = fig.root.querySelector<HTMLButtonElement>('[data-f6-play]');
    let running = false;

    const select = (key: string) => {
      nodes.forEach((n) => n.setAttribute('aria-pressed', String(n.dataset.mem === key)));
      infos.forEach((i) => (i.hidden = i.dataset.memInfo !== key));
      if (hint) hint.hidden = true;
      const name = nodes.find((n) => n.dataset.mem === key)?.querySelector('.mem-title')?.textContent;
      if (name) announce(fig, `Showing ${name}.`);
    };

    nodes.forEach((n) => {
      const name = n.querySelector('.mem-title')?.textContent ?? '';
      n.setAttribute('role', 'button');
      n.setAttribute('tabindex', '0');
      n.setAttribute('aria-pressed', 'false');
      n.setAttribute('aria-label', `${name}: show what it holds`);
      n.addEventListener('click', () => select(n.dataset.mem ?? ''));
      n.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          select(n.dataset.mem ?? '');
        }
      });
    });

    const run = async () => {
      if (running || prefersReducedMotion()) return;
      const svg = svgs.find(visible);
      if (!svg) return;
      running = true;
      const steps = new Map<number, SVGPathElement[]>();
      svg.querySelectorAll<SVGPathElement>('path.edge').forEach((p) => {
        const s = Number(p.dataset.step);
        steps.set(s, [...(steps.get(s) ?? []), p]);
      });
      for (const s of [...steps.keys()].sort()) await flow(svg, steps.get(s) ?? [], 800);
      running = false;
    };

    if (play && !prefersReducedMotion()) {
      play.hidden = false;
      play.addEventListener('click', run);
    }
    showControls(fig);
    onceInView(fig.svg, run, 0.5);
  }
</script>
