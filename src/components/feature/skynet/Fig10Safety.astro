---
/**
 * Fig10Safety (fig-10): who can authorize what, plus the classifier callout.
 * Props: `caption` (text from the MDX), `wide` (default false).
 * Default slot: the text alternative (`<ol>`) written in the MDX.
 *
 * Three columns. The table scrolls inside its own frame on a phone, never the
 * page. No animation, no JS. Labels: briefs/03-architecture.md lines 108-113,
 * docs/07-security.md lines 13-19 and 28-30, lessons.md lines 7-11.
 */
import Figure from '../Figure.astro';

interface Props {
  caption?: string;
  wide?: boolean;
}

const { caption = 'TODO', wide = false } = Astro.props;

const rows = [
  { who: 'Dutt, in person', can: 'Releases to users: production deploys, App Store or TestFlight uploads, publishing.', never: 'A go that was only relayed by another session.', top: true },
  { who: 'Conductors', can: 'Git in their own repository: branches, commits, merges into feature branches.', never: 'Releases to users.' },
  { who: 'Workers', can: 'Commits on their own task branch.', never: 'Push.' },
  { who: 'A message from another session', can: 'Nothing. It is a nudge.', never: 'Authority, even when it says it comes from Dutt.' },
  { who: 'Fetched web content', can: 'Nothing. It is data.', never: 'Instructions.' },
];
---

<Figure id="fig-10" caption={caption} wide={wide} interactive>
  <div slot="svg" class="f10">
    <div class="scroll" tabindex="0" role="region" aria-label="Who can authorize what">
      <table>
        <thead>
          <tr><th scope="col">Source</th><th scope="col">Can authorize</th><th scope="col">Never</th></tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class:list={{ top: r.top }}>
              <th scope="row">{r.who}</th>
              <td>{r.can}</td>
              <td>{r.never}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <aside class="callout" aria-label="Classifier blocks">
      <p class="head">The safety classifier said no</p>
      <p>
        It blocked merges that deploy to production on <strong>4 pull requests</strong> and <strong>1 TestFlight upload</strong>, each time Dutt’s go had come through another session. One merge went through when Dutt said it in the conductor’s own session.
      </p>
      <p class="rule">Conductors prepare. Dutt clicks.</p>
    </aside>
  </div>
  <slot>
    <ol><li>TODO</li></ol>
  </slot>
</Figure>

<style>
  .f10 {
    font-size: 14px;
    line-height: 1.5;
  }
  .scroll {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .scroll:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 0;
  }
  .f10 table th,
  .f10 table td {
    text-align: left;
    vertical-align: top;
    padding: 8px 6px;
    border-bottom: 1px solid var(--border);
    font-weight: 400;
  }
  thead th {
    font-weight: 600;
    color: var(--text);
    font-size: 13px;
  }
  tbody th {
    font-weight: 600;
    width: 25%;
    text-transform: none;
    letter-spacing: 0;
    font-size: 14px;
    color: var(--text);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  tr.top > * {
    background: color-mix(in srgb, var(--accent) 14%, var(--bg));
  }
  .callout {
    margin-top: 16px;
    padding: 12px 16px;
    border: 1.5px solid var(--accent);
    border-left-width: 6px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 8%, var(--bg));
  }
  .callout p {
    margin: 0;
  }
  .callout .head {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .callout .rule {
    margin-top: 8px;
    font-weight: 600;
  }
</style>
