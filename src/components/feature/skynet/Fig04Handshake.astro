---
/**
 * Fig04Handshake (fig-04): Handshake.
 * Props: `caption` (text from the MDX), `wide` (default false).
 * Default slot: the text alternative (`<ol>`) written in the MDX.
 *
 * Drawing: one vertical inline SVG (phone first, also fine in the 640px
 * column): two lanes, parent and new worker, five beats, and a callout on
 * why the ack matters. Labels: 03-architecture.md Diagram C (lines 40-53).
 * Message text uses the real short shapes with {ts} for the timestamp.
 * Motion: Play runs the five beats once (createStepper); Prev / Next / dots
 * step through. Later beats are faint until reached. Reduced motion: no
 * Play button and no fades; the step buttons work. No JS: all five beats
 * are drawn and the controls stay hidden.
 */
import Figure from '../Figure.astro';

interface Props {
  caption?: string;
  wide?: boolean;
}

const { caption = 'TODO', wide = false } = Astro.props;

const PX = 64; // parent lane x
const WX = 256; // worker lane x
const Y0 = 96;
const GAP = 70;

// kind: self = note beside the parent lane; right = parent to worker; left = worker to parent.
const BEATS = [
  { kind: 'self', lines: ['write {ts}-prompt.md'], text: 'The parent writes {ts}-prompt.md' },
  { kind: 'right', lines: ['start worker', 'it reads the goal only'], text: 'The parent starts the worker in a named session. It reads only the goal.' },
  { kind: 'left', lines: ['ack: {ts} ready'], text: 'ack: {ts} ready. The worker proves it is running and reachable.', key: true },
  { kind: 'right', lines: ['go: {ts}'], text: 'go: {ts}. The parent releases the worker.' },
  { kind: 'left', lines: ['report ready: {ts}', 'status=done'], text: 'report ready: {ts} status=done, after the work and the report file.' },
];
const by = (i: number) => Y0 + i * GAP;
const noteY = by(BEATS.length - 1) + 44;
const H = noteY + 104;
---

<Figure id="fig-04" caption={caption} wide={wide} interactive>
  <div slot="svg" class="f4">
    <svg viewBox={`0 0 320 ${H}`} xmlns="http://www.w3.org/2000/svg">
      <defs>
        <marker id="f4-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto">
          <path d="M0 0 L10 5 L0 10 z" class="arr-head" />
        </marker>
      </defs>
      <line class="lane-line" x1={PX} y1="52" x2={PX} y2={noteY - 20} />
      <line class="lane-line" x1={WX} y1="52" x2={WX} y2={noteY - 20} />
      <rect class="lane-box" x={PX - 52} y="8" width="104" height="40" rx="8" />
      <text class="lane-name" x={PX} y="33" text-anchor="middle">parent</text>
      <rect class="lane-box" x={WX - 52} y="8" width="104" height="40" rx="8" />
      <text class="lane-name" x={WX} y="33" text-anchor="middle">new worker</text>

      {BEATS.map((b, i) => {
        const y = by(i);
        return (
          <g class:list={['beat', { key: b.key }]} data-step={i} data-text={b.text}>
            <rect class="band" x="0" y={y - 30} width="320" height="58" rx="8" />
            <circle class="badge" cx="20" cy={y - 14} r="11" />
            <text class="badge-n" x="20" y={y - 10} text-anchor="middle">{i + 1}</text>
            {b.kind === 'self' ? (
              <>
                <path class="edge" d={`M${PX} ${y - 8} h22 v22 h-18`} marker-end="url(#f4-arr)" />
                {b.lines.map((t, k) => (
                  <text class="msg fig-mono" x={PX + 34} y={y + 10 + k * 16}>{t}</text>
                ))}
              </>
            ) : (
              <>
                <path
                  class="edge"
                  d={b.kind === 'right' ? `M${PX + 4} ${y} H${WX - 6}` : `M${WX - 4} ${y} H${PX + 6}`}
                  marker-end="url(#f4-arr)"
                />
                {b.lines.map((t, k) => (
                  <text class:list={['msg', { 'fig-mono': k === 0 && i > 1 }]} x={(PX + WX) / 2} y={k === 0 ? y - 8 : y + 20} text-anchor="middle">{t}</text>
                ))}
              </>
            )}
          </g>
        );
      })}

      <g class="callout">
        <rect class="note-box" x="8" y={noteY} width="304" height="92" rx="8" />
        <text class="note-title" x="22" y={noteY + 24}>Why the ack</text>
        <text class="note" x="22" y={noteY + 44}>A window that opened does not prove</text>
        <text class="note" x="22" y={noteY + 62}>an agent is running and reachable</text>
        <text class="note" x="22" y={noteY + 80}>by name. The ack does.</text>
      </g>
    </svg>
  </div>
  <slot>
    <ol><li>TODO</li></ol>
  </slot>
</Figure>

<style>
  .f4 svg {
    max-width: 440px;
    margin: 0 auto;
  }
  .band {
    fill: transparent;
    stroke: transparent;
  }
  .badge {
    fill: var(--code-bg);
    stroke: var(--muted);
    stroke-width: 1.5;
  }
  .badge-n {
    font-size: 13px;
    font-weight: 600;
  }
  .lane-box {
    fill: var(--code-bg);
    stroke: var(--muted);
    stroke-width: 1.5;
  }
  .lane-name {
    font-size: 14px;
    font-weight: 600;
  }
  .lane-line {
    stroke: var(--border);
    stroke-width: 2;
    stroke-dasharray: 4 4;
  }
  .edge {
    fill: none;
    stroke: var(--text);
    stroke-opacity: 0.6;
    stroke-width: 1.5;
  }
  .arr-head {
    fill: var(--text);
    fill-opacity: 0.6;
  }
  .msg {
    font-size: 13px;
  }
  /* The ack is the point of the figure: heavier arrow, accent mark. */
  .beat.key .edge {
    stroke: var(--accent);
    stroke-opacity: 1;
    stroke-width: 3;
  }
  .note-box {
    fill: color-mix(in srgb, var(--accent) 12%, var(--bg));
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .note-title {
    font-size: 13px;
    font-weight: 600;
  }
  .note {
    font-size: 13px;
  }

  /* JS only: later beats are faint until reached; the active beat is marked. */
  .f4[data-js] .beat.later {
    opacity: 0.25;
  }
  .beat.on .band {
    fill: color-mix(in srgb, var(--accent) 16%, var(--bg));
    stroke: var(--accent);
    stroke-width: 2;
  }
  .beat.on .badge {
    fill: var(--accent);
    stroke: var(--accent);
  }
  .beat.on .badge-n {
    fill: #222222;
  }
  @media (prefers-reduced-motion: no-preference) {
    .beat {
      transition: opacity 0.3s ease;
    }
  }
</style>

<script>
  import { getFigure } from '../figure';
  import { createStepper } from '../stepper';

  const fig = getFigure('fig-04');
  if (fig) {
    const wrap = fig.root.querySelector<HTMLElement>('.f4');
    const beats = Array.from(fig.root.querySelectorAll<SVGGElement>('.beat'));
    const texts = beats.map((b) => b.dataset.text ?? '');
    wrap?.setAttribute('data-js', '');
    createStepper(fig, {
      steps: texts,
      start: beats.length - 1, // final state first; Play starts again from beat 1
      playLabel: 'Play',
      playDelayMs: 1400,
      onStep(i) {
        beats.forEach((b, k) => {
          b.classList.toggle('on', k === i);
          b.classList.toggle('later', k > i);
        });
      },
    });
  }
</script>
