---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { Github, Linkedin, Mail } from 'lucide-astro';
const base = import.meta.env.BASE_URL;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const work = [
  { slug: 'oareo', title: 'Oareo', meta: 'Measure a room with your phone' },
  { slug: 'periodiq', title: 'Periodiq', meta: 'The periodic table, in 3D' },
  { slug: 'domain-check', title: 'domain-check', meta: 'Find a free domain name, fast' },
  { slug: 'meontor', title: 'Meontor', meta: 'A daily log that reflects back' },
  { slug: 'doorframe', title: 'Doorframe', meta: 'Height marks, without the pencil' },
];
---

<BaseLayout title="gvs" description="Software engineer, curious about how things work. Projects, writing, and the tools I use." activeNav="about">
  <div class="hero">
    <h1>Hi, I'm Venkata Sai Dutt Ganduri</h1>
    <p class="subtitle">Software engineer. Curious about how things work.</p>
    <div class="bio">
      <p>
        I have been building software for nine years. At
        <a href="https://www.centralsquare.com" target="_blank" rel="noopener">CentralSquare Technologies</a>,
        I work across the full stack on software that local governments, public safety agencies,
        and courts use every day. It is work where a quiet, reliable system matters more than a clever one.
      </p>
      <p>
        On my own time, I build things to understand them. I wanted to see an f orbital from every
        side, so I wrote the math to draw one. I wanted to know if a phone could measure a room well
        enough to trust, so I made an app that does it. Some of these became tools that other people
        now use. All of them are on the <a href={`${base}projects/`}>projects</a> page.
      </p>
      <p>
        Away from the screen, I like machines with moving parts: engines, electronics, anything I can
        take apart in my head. I keep bonsai, and I look up at the night sky more than most people do.
      </p>
    </div>
    <div class="social">
      <a href="https://github.com/saidutt46" target="_blank" rel="noopener">
        <Github size={16} /> github
      </a>
      <a href="https://linkedin.com/in/venkata-sai-dutt-ganduri-34a1a45a" target="_blank" rel="noopener">
        <Linkedin size={16} /> linkedin
      </a>
      <a href="https://x.com/saidutt_46" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        x
      </a>
      <a href="mailto:saidutt46@gmail.com">
        <Mail size={16} /> email
      </a>
    </div>
  </div>

  <div class="content home-sections">
    <div class="section-header">
      <h2 class="section-title">Selected work</h2>
    </div>
    <ul class="post-list">
      {work.map((w) => (
        <li class="post-item">
          <a class="post-title" href={`${base}projects/${w.slug}/`}>{w.title}</a>
          <span class="post-date">{w.meta}</span>
        </li>
      ))}
    </ul>

    {posts.length > 0 && (
      <>
        <div class="section-header">
          <h2 class="section-title">Writing</h2>
        </div>
        <PostList items={posts} basePath="blog" />
      </>
    )}
  </div>
</BaseLayout>
