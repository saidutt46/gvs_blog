---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Github, Linkedin, Mail } from 'lucide-astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="gvs" description="Software developer, tinkerer, and writer." activeNav="about">
  <div class="hero">
    <h1>Hi, I'm Venkata Sai Dutt Ganduri</h1>
    <p class="subtitle">Software developer. Tinkerer. Curious about how things work.</p>
    <div class="bio">
      <p>
        I'm a full-stack developer at <a href="https://www.centralsquare.com" target="_blank" rel="noopener">CentralSquare Technologies</a>,
        where I build public administration, public safety, and justice software.
      </p>
      <p>
        Outside of work, I build tools and apps. Rust CLIs, iOS apps, developer utilities.
        Check out my <a href={`${base}projects/`}>projects</a> for the full list.
      </p>
      <p>
        I like understanding how things work: electrons, engines, programs, the natural world.
        I spend time with bonsai plants and look up at the sky more than most people.
      </p>
    </div>
    <div class="social">
      <a href="https://github.com/saidutt46" target="_blank" rel="noopener">
        <Github size={16} /> github
      </a>
      <a href="https://linkedin.com/in/venkata-sai-dutt-ganduri-34a1a45a" target="_blank" rel="noopener">
        <Linkedin size={16} /> linkedin
      </a>
      <a href="https://x.com/saidutt_46" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        x
      </a>
      <a href="mailto:saidutt46@gmail.com">
        <Mail size={16} /> email
      </a>
    </div>
  </div>
</BaseLayout>
