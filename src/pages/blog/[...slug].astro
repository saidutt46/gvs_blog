---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostLayout from '../../components/PostLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} activeNav="blog">
  <PostLayout title={post.data.title} date={post.data.date} backLink="blog/" backLabel="back to blog">
    <Content />
  </PostLayout>
</BaseLayout>
