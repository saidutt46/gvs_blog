---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog" description="Thoughts on building things, technology, and life." activeNav="blog">
  <div class="content">
    <div class="section-header">
      <h2 class="section-title">Blog</h2>
      <p class="section-desc">Thoughts on building things, technology, and life.</p>
    </div>

    {posts.length > 0 ? (
      <PostList items={posts} basePath="blog" />
    ) : (
      <p style="color: var(--muted); padding: 24px 0;">No posts yet. Check back soon.</p>
    )}
  </div>
</BaseLayout>
